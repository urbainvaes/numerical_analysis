<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <!-- GENERATED by make_variants.py. Variant that prints only the citation number, used to color it. Approximation of biblatex-trad's trad-abbrv style, with the customizations in preamble.tex -->
  <info>
    <title>Trad abbrv (lecture notes, bare citation numbers)</title>
    <id>trad-abbrv-lecture-notes-number</id>
    <updated>2026-10-21T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name and="text" initialize-with=". " delimiter=", " delimiter-precedes-last="contextual" et-al-min="99">
        <name-part name="given" font-variant="small-caps"/>
        <name-part name="family" font-variant="small-caps"/>
      </name>
    </names>
  </macro>
  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" and="text" delimiter=", "/>
      <!-- Entries without author are sorted by title, as with biblatex -->
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="title-italic">
    <text variable="title" font-style="italic"/>
  </macro>
  <macro name="title-plain">
    <text variable="title"/>
  </macro>
  <macro name="edition">
    <text variable="edition" text-case="lowercase" suffix=" edition"/>
  </macro>
  <!-- DOI and URL on new lines of the same paragraph (U+2028 is a forced line break in Typst) -->
  <macro name="doi-url">
    <group prefix="&#x2028;">
      <text value="doi" font-variant="small-caps" suffix=": "/>
      <text variable="DOI" suffix="."/>
    </group>
    <group prefix="&#x2028;">
      <text value="url" font-variant="small-caps" suffix=": "/>
      <text variable="URL" suffix="."/>
    </group>
  </macro>
  <macro name="body">
    <choose>
      <if type="book">
        <group delimiter=". " suffix=".">
          <text macro="author"/>
          <group delimiter=", ">
            <text macro="title-italic"/>
            <group delimiter=" of ">
              <group delimiter=" ">
                <choose>
                  <if variable="volume">
                    <text value="volume"/>
                  </if>
                </choose>
                <text variable="volume" font-weight="bold"/>
              </group>
              <choose>
                <if variable="volume">
                  <text variable="collection-title" font-style="italic"/>
                </if>
              </choose>
            </group>
          </group>
          <choose>
            <if variable="volume" match="none">
              <text variable="collection-title"/>
            </if>
          </choose>
          <group delimiter=", ">
            <text variable="publisher"/>
            <text macro="edition"/>
            <date variable="issued"><date-part name="year"/></date>
          </group>
        </group>
      </if>
      <else-if type="article-journal">
        <group delimiter=". " suffix=".">
          <text macro="author"/>
          <text macro="title-plain"/>
          <group delimiter=", ">
            <group>
              <text variable="container-title" font-style="italic"/>
              <group prefix=", ">
                <text variable="volume" font-weight="bold"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page" prefix=":"/>
            </group>
            <date variable="issued"><date-part name="year"/></date>
          </group>
        </group>
      </else-if>
      <else-if type="paper-conference">
        <group delimiter=". " suffix=".">
          <text macro="author"/>
          <text macro="title-plain"/>
          <group delimiter=", ">
            <group delimiter=" ">
              <text value="In"/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <group delimiter=" ">
              <text value="pages"/>
              <text variable="page"/>
            </group>
            <date variable="issued"><date-part name="year"/></date>
          </group>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=". " suffix=".">
          <text macro="author"/>
          <text macro="title-plain"/>
          <group delimiter=", ">
            <text value="Technical report"/>
            <text variable="publisher"/>
            <date variable="issued"><date-part name="year"/></date>
          </group>
        </group>
      </else-if>
      <else>
        <group delimiter=". " suffix=".">
          <text macro="author"/>
          <group delimiter=", ">
            <text macro="title-plain"/>
            <date variable="issued"><date-part name="year"/></date>
          </group>
        </group>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <sort>
      <key macro="author-sort"/>
      <key variable="title"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="body"/>
      <text macro="doi-url"/>
    </layout>
  </bibliography>
</style>
